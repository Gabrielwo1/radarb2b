# URL da API na VPS (em dev: túnel SSH para localhost:3000 da VPS)
API_URL=http://localhost:3001
API_KEY=

# Busca inteligente: configure UMA das chaves (OpenAI tem prioridade se as duas existirem).
# Sem nenhuma, a busca usa interpretação por palavras-chave + dicionário de segmentos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=

# Contato da equipe para ativar a Automação com IA (WhatsApp com DDI, ex.: 5541999998888; ou e-mail)
NEXT_PUBLIC_WHATSAPP_EQUIPE=
NEXT_PUBLIC_EMAIL_EQUIPE=

# Ligue quando o e-mail de confirmação trouxer código (requer SMTP próprio no Supabase)
NEXT_PUBLIC_CONFIRMACAO_CODIGO=

# Modo de desenvolvimento sem login: só funciona com `npm run dev` (ignorado em produção)
DEV_SEM_LOGIN=
NEXT_PUBLIC_DEV_SEM_LOGIN=

# Mercado Pago (checkout transparente): Suas integrações → Credenciais de produção
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Webhooks → assinatura secreta (opcional, mas recomendado)
MP_WEBHOOK_SECRET=
# Segredo do servidor para liberar planos (o hash fica na migração 20261102120000_planos_pagamentos.sql)
PAGAMENTOS_SEGREDO=

# E-mails (Resend): chave só de envio; remetente precisa do domínio verificado no Resend
RESEND_API_KEY=
EMAIL_REMETENTE="Radar B2B <ola@b2bradar.pro>"
EMAIL_RESPOSTA=
# Vercel Cron: protege /api/cron/emails
CRON_SECRET=

# Painel /admin: e-mails com acesso (separados por vírgula)
ADMIN_EMAILS=
